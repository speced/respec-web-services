{
  "name": "respec.org",
  "version": "1.0.0",
  "description": "respec.org website and HTTP APIs",
  "main": "app.ts",
  "repository": "git@github.com:marcoscaceres/respec.org.git",
  "author": "Marcos Caceres <marcos@marcosc.com>",
  "type": "module",
  "license": "MIT",
  "imports": {
    "#*": "./*"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "nanoid": "^6.0.1",
    "serialize-error": "^13.0.1",
    "split2": "^4.2.0",
    "ucontent": "^2.0.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "typecheck:watch": "tsc -w",
    "prestart": "npm run update-data-sources && npm run regenerate-docs",
    "start": "node --env-file-if-exists=.env app.ts",
    "start:server": "pm2 start ecosystem.config.cjs --env production",
    "test": "jasmine --config=tests/jasmine.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "regenerate-docs": "node --trace-warnings ./scripts/regenerate-docs.ts",
    "update-data-sources": "node --env-file-if-exists=.env scripts/update-data-sources.ts"
  },
  "packageManager": "pnpm@12.5.1",
  "simple-git-hooks": {
    "post-merge": "pnpm i"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^6.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/split2": "^4.2.3",
    "jasmine": "^7.0.0",
    "node-mocks-http": "^1.18.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  }
}
