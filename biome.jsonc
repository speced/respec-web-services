{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!vendor", "!static/xref/fuse.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off" // we use autofocus carefully, on purpose
      },
      "complexity": {
        "noImportantStyles": "off" // too many changes, revisit later
      },
      "style": {
        "noNonNullAssertion": "off" // too many instances, revisit later
      },
      "suspicious": {
        "noDuplicateProperties": "off", // some duplicates are intentional fallbacks
        "noExplicitAny": "off" // too many instances, revisit later
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "never",
      "indentScriptAndStyle": true,
      "lineWidth": 90
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              [":ALIAS:"],
              [":PATH:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // tests/ isn't part of tsconfig.json's type-checked include yet
            "noImplicitAnyLet": "off"
          }
        }
      }
    },
    {
      // this directory already used single quotes; too many changes to flip now, revisit later
      "includes": ["static/xref/**"],
      "javascript": {
        "formatter": {
          "quoteStyle": "single"
        }
      }
    }
  ]
}
